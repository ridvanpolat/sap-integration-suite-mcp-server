# =============================================================================
# SAP Integration Suite MCP Server — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in values for the domains you need.
# Only domains whose _URL variable is set will be activated at runtime.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Cloud Integration (CPI)
# ---------------------------------------------------------------------------
SAP_CPI_URL=https://<tenant>.it-cpi018.cfapps.<region>.hana.ondemand.com/api/v1
SAP_CPI_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
SAP_CPI_CLIENT_ID=
SAP_CPI_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 2. API Management (APIM)
# ---------------------------------------------------------------------------
SAP_APIM_URL=https://<tenant>.apimanagement.<region>.hana.ondemand.com/apiportal/api/1.0
SAP_APIM_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
SAP_APIM_CLIENT_ID=
SAP_APIM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 3. Event Mesh
# ---------------------------------------------------------------------------
SAP_EM_URL=https://enterprise-messaging-pubsub.cfapps.<region>.hana.ondemand.com
SAP_EM_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
SAP_EM_CLIENT_ID=
SAP_EM_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 4. Integration Assessment
# ---------------------------------------------------------------------------
SAP_IA_URL=https://<tenant>.integrationsuite.<region>.hana.ondemand.com/api/v1
SAP_IA_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
SAP_IA_CLIENT_ID=
SAP_IA_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 5. Open Connectors
# ---------------------------------------------------------------------------
SAP_OC_URL=https://api.openconnectors.ext.<region>.hana.ondemand.com/elements/api-v2
SAP_OC_USER_SECRET=
SAP_OC_ORG_SECRET=

# ---------------------------------------------------------------------------
# 6. Edge Integration Cell
# ---------------------------------------------------------------------------
SAP_EIC_URL=https://<host>/api/v1
SAP_EIC_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token
SAP_EIC_CLIENT_ID=
SAP_EIC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Global Settings
# ---------------------------------------------------------------------------
# Maximum records returned per paginated request (default: 50)
SAP_MAX_RESULTS=50

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
