{
  "name": "sap-integration-suite-mcp-server",
  "version": "1.0.7",
  "description": "A production-ready Model Context Protocol (MCP) server for the SAP Integration Suite, providing unified access to Cloud Integration, API Management, Event Mesh, Integration Assessment, Open Connectors, and Edge Integration Cell.",
  "author": "Ridvan Polat <rp@ridvanpolat.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridvanpolat/sap-integration-suite-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/ridvanpolat/sap-integration-suite-mcp-server/issues"
  },
  "homepage": "https://github.com/ridvanpolat/sap-integration-suite-mcp-server#readme",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js",
    "start:sse": "node dist/sse.js",
    "start:streamable-http": "node dist/streamable-http.js",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/index.ts",
    "dev:sse": "tsx src/sse.ts",
    "dev:streamable-http": "tsx src/streamable-http.ts",
    "run:stdio": "tsx watch src/index.ts",
    "run:sse": "tsx watch src/sse.ts",
    "run:streamable-http": "tsx watch src/streamable-http.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "generate": "tsx scripts/generate-types-and-metadata.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.1",
    "@types/swagger2openapi": "^7.0.4",
    "msw": "^2.7.3",
    "openapi-typescript": "^7.6.1",
    "swagger2openapi": "^7.0.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0"
}